{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halley-7.local/schemas/event-v1.json",
  "title": "Halley-7 Evidence Event",
  "description": "Normalized event wrapper that preserves the exact source record, including records that could not be parsed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source_id",
    "source_record_id",
    "record_original",
    "event_type",
    "content",
    "validation_status",
    "provenance",
    "ingested_at_utc",
    "schema_version"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "occurred_at_utc": {"type": ["string", "null"], "format": "date-time", "description": "Normalized timestamp. Use UTC offset Z; null when unknown or invalid."},
    "time_original": {"type": ["string", "null"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1, "description": "Stable row, line, key, or record locator in the source."},
    "record_original": {"description": "Exact source text/object or immutable reference to original bytes; never replaced by parsed content."},
    "event_type": {"type": "string", "enum": ["card_read", "presence_reading", "temperature_reading", "radio_message", "energy_reading", "log_entry", "reference_record", "unknown"]},
    "content": {"type": "object", "description": "Parsed fields. Keep only source-derived values and explicit normalization metadata."},
    "validation_status": {"type": "string", "enum": ["valid", "invalid", "ambiguous", "duplicate_candidate", "conflicting", "unparsed"]},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "location": {"type": ["string", "null"]}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["file", "sha256", "parser_version"], "properties": {"file": {"type": "string"}, "sha256": {"type": ["string", "null"], "description": "SHA-256 of the exact original source-file bytes, before UTF-8 decoding."}, "parser_version": {"type": "string"}, "location": {"type": ["string", "null"]}}},
    "identity": {"type": ["object", "null"], "additionalProperties": false, "properties": {"as_recorded": {"type": ["string", "null"]}, "canonical_id": {"type": ["string", "null"]}, "alias_applied": {"type": ["string", "null"]}, "resolution_status": {"type": "string", "enum": ["resolved", "unresolved", "ambiguous", "not_applicable"]}}},
    "ingested_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "schema_version": {"const": "1"},
    "correction_of": {"type": ["string", "null"], "description": "ID of the original event if this record is a correction; correction is stored separately."}
  }
}
