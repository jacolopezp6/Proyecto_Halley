cabal-version:      3.0
name:               halley-member1
version:            0.1.0.0
build-type:         Simple

executable halley-member1
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Halley.Event, Halley.Ingest, Halley.Sha256
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -Werror
  build-depends:
      base >=4.18 && <5
    , bytestring
    , containers
    , parsec
    , text
    , time

test-suite member1-tests
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   ../../tests/haskell, src
  other-modules:    Halley.Event, Halley.Ingest, Halley.Sha256
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -Werror
  build-depends:
      base >=4.18 && <5
    , bytestring
    , containers
    , parsec
    , text
    , time
